# ============================================
# 后端环境变量配置模板
# 使用方法：复制本文件为 .env，填入真实值
# 注意：.env 文件已加入 .gitignore，不会被提交
# ============================================

# ---------- Supabase 数据库 ----------
# Supabase 控制台 → Project Settings → Database → Connection string
SUPABASE_DB_PASSWORD=your_supabase_db_password

# ---------- Supabase S3 存储 ----------
# Supabase 控制台 → Project Settings → Storage → S3 Connection
SUPABASE_STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=ap-northeast-2
SUPABASE_STORAGE_ACCESS_KEY=your_s3_access_key
SUPABASE_STORAGE_SECRET_KEY=your_s3_secret_key
SUPABASE_STORAGE_BUCKET=pdfs
SUPABASE_STORAGE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# ---------- 通义千问 / 阿里百炼 AI ----------
# 阿里云百炼控制台 → API-KEY 管理
DASHSCOPE_API_KEY=sk-your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_TIMEOUT_SECONDS=180

# ---------- JWT 认证 ----------
# 生产环境请使用至少 32 字节的随机字符串
# 生成方法：openssl rand -base64 48
JWT_SECRET=your_jwt_secret_at_least_32_bytes
JWT_EXPIRATION_MS=7200000

# ---------- Tesseract OCR（可选） ----------
# 安装 Tesseract 后填写 tessdata 目录路径
TESSERACT_DATA_PATH=
